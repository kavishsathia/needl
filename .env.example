NEEDL_TENANT_ID=local-demo
NEEDL_DB_PATH=./needl-events.sqlite
PORT=8787

# Full-stack web service (apps/web). Production requires PostgreSQL and an
# explicit allowlist; leave real values in the hosting secret store only.
DATABASE_URL=postgresql://needl_user:replace@dedicated-needl-host/needl?sslmode=require
BETTER_AUTH_URL=https://needl-monitoring-preview.onrender.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
NEEDL_TRUSTED_ORIGINS=https://needl-monitoring-preview.onrender.com
NEEDL_SIGNUP_ALLOWLIST=approved-user@example.com
NEEDL_TRANSLATION_DAILY_LIMIT=5
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Replace every placeholder locally. Never commit real values.
GITLAB_AUTH_MODE=signing-token
GITLAB_WEBHOOK_SECRET=whsec_BASE64_KEY_FROM_GITLAB
LINEAR_WEBHOOK_SECRET=replace-me
LAUNCHDARKLY_WEBHOOK_SECRET=replace-me
SENTRY_WEBHOOK_SECRET=replace-me
POSTHOG_AUTH_MODE=standard-webhooks
POSTHOG_WEBHOOK_SECRET=whsec_BASE64_KEY_FROM_POSTHOG
POSTHOG_SHARED_HEADER=Authorization
POSTHOG_SHARED_PREFIX=Bearer 
INTERCOM_WEBHOOK_SECRET=replace-with-app-client-secret
STRIPE_WEBHOOK_SECRET=whsec_replace-me
