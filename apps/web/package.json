{
  "name": "@needl/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch --env-file-if-exists=../../.env server.ts --api-only\" \"vite\"",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "test": "vitest run --config vitest.config.ts",
    "serve": "tsx --env-file-if-exists=../../.env server.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env backend/migrate.ts",
    "db:configure-integrations": "tsx --env-file-if-exists=../../.env backend/configure-integrations.ts",
    "smoke:openai": "tsx backend/live-openai-smoke.ts",
    "e2e": "playwright test",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "better-auth": "^1.7.12",
    "kysely": "^0.29.6",
    "openai": "^7.33.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
