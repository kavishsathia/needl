{
  "name": "@needl/integrations",
  "version": "0.1.0",
  "description": "Needl webhook integrations and durable LTL runtime monitoring",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./receiver": {
      "types": "./dist/receiver/index.d.ts",
      "import": "./dist/receiver/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./ltl": {
      "types": "./dist/ltl/index.d.ts",
      "import": "./dist/ltl/index.js"
    },
    "./ltl/sqlite": {
      "types": "./dist/ltl/sqlite.d.ts",
      "import": "./dist/ltl/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node tests/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "example": "tsx examples/server.ts",
    "demo:ltl": "tsx examples/ltl-demo.ts",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web run test",
    "web:serve": "npm --prefix apps/web run serve",
    "web:e2e": "npm --prefix apps/web run e2e",
    "check:all": "npm run check && npm run web:test && npm run web:build"
  },
  "keywords": [
    "webhook",
    "gitlab",
    "linear",
    "launchdarkly",
    "sentry",
    "posthog",
    "intercom",
    "stripe",
    "ltl",
    "runtime-verification"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
